# layouts :3
layout {
    0 bsp
    1 bsp
    2 bsp
    * bsp
}

# keybinds [
#     alt, s, bsp:togglesplit
#     alt, return, spawn foot
# ]

windowrules [
    com.mitchellh.ghostty, workspace 1
    zenity, float
]

keyboard {
    # layout en
    # variant
    # options grp:ctrl_space_toggle
    repeat {
        rate 25
        delay 550
    }
}

touchpad {
    natural_scroll true
    tap_to_click true
}

startup [
    kanshi
    awww-daemon
    swayidle
    dbus-update-activation-environment, --all, --systemd
]
